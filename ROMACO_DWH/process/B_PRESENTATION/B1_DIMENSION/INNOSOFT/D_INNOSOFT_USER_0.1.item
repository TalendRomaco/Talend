  <node componentName="tMSSqlInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="96" posY="128">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tMSSqlInput_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tMSSqlConnection_1" show="false"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:PROPERTY_TYPE" value="REPOSITORY"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:REPOSITORY_PROPERTY_TYPE" value="_eRpNoOjiEeiPup4IvSqYiw" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="context.DWH_STAGE_SERVER"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="JTDS"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="context.DWH_STAGE_PORT"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="context.DWH_STAGE_SCHEMA"/>
    <elementParameter field="TEXT" name="DBNAME" value="context.DWH_STAGE_DATABASE"/>
    <elementParameter field="TEXT" name="USER" value="context.DWH_STAGE_LOGIN"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:1r45t+CoY+Lcw0651a8L8Gl7H6LMEiizuRrDeSKk641TVE4lnDFUPByPgYt0WszX1oQXqroh"/>
    <elementParameter field="DBTABLE" name="TABLE" value="pwuser+&lt;br>pwzusatz+&lt;br>option_o&lt;br>option_g"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;&#xD;&#xA;SELECT&#xD;&#xA;    PWUSER.NAME as USER_ID, &#xD;&#xA;&#x9;PWUSER.WINUSER as USER_WINDOWS_NAME,&#xD;&#xA;    PWUSER.NAME2 as USER_NAME,&#xD;&#xA;    PWUSER.GRNR as GROUP_ID,&#xD;&#xA;    OG.GRUPPE as GROUP_NAME,&#xD;&#xA;    PWUSER.OGRNR as SUPERGROUP_ID,&#xD;&#xA;    OO.OBERGRUPPE as SUPERGROUP_NAME,&#xD;&#xA;&#x9;PWUSER.ABTEILUNG as DEPARTMENT,&#xD;&#xA;&#x9;CASE BESCHREIBUNG&#xD;&#xA;&#x9;&#x9;WHEN 0 THEN 'Aktiv'&#xD;&#xA;&#x9;&#x9;WHEN 1 THEN 'Gesperrt für interaktive Programme'&#xD;&#xA;&#x9;&#x9;WHEN 2 THEN 'Gesperrt für alle Programme'&#xD;&#xA;&#x9;END AS STATUS,&#xD;&#xA;&#x9;RECHTSY as PRIVILEGE_SYSTEM,&#xD;&#xA;    RECHTGP as PRIVILEGE_ROUGH_PLANNING,&#xD;&#xA;    RECHTFP as PRIVILEGE_DETAILED_PLANNING,&#xD;&#xA;    PERSONALDATENRECHT as PRIVILEGE_PERSONNEL_DATA,&#xD;&#xA;    RECHTPE as PRIVILEGE_PERSONAL_DATA,&#xD;&#xA;    RECHTGR  as PRIVILEGE_BASIC_DATA,&#xD;&#xA;    RECHTFEHL as PRIVILEGE_OTHER_TIMES,&#xD;&#xA;    RECHTFA as PRIVILEGE_INVOICING&#xD;&#xA;FROM STG.S_INNOSOFT_PWUSER AS PWUSER&#xD;&#xA;LEFT JOIN&#xD;&#xA;STG.S_INNOSOFT_PWZUSATZ ZUSATZ&#xD;&#xA;ON PWUSER.NAME = ZUSATZ.LOGIN&#xD;&#xA;AND GRUPPE = 0&#xD;&#xA;and ZAEHLER = 180&#xD;&#xA;LEFT JOIN&#xD;&#xA;STG.S_INNOSOFT_OPTION_O OO&#xD;&#xA;ON PWUSER.OGRNR = OO.OGRNR&#xD;&#xA;AND OO.LANGUAGE = 2&#xD;&#xA;LEFT JOIN&#xD;&#xA;STG.S_INNOSOFT_OPTION_G OG&#xD;&#xA;ON PWUSER.GRNR = OG.GRNR&#xD;&#xA;AND OG.LANGUAGE = 2&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
    <elementParameter field="TEXT" name="DATASOURCE_ALIAS" value="&quot;&quot;" show="false"/>
    <elementParameter field="MAPPING_TYPE" name="MAPPING" value="id_MSSQL" show="false"/>
    <elementParameter field="TEXT" name="PROPERTIES" value="context.DWH_STAGE_ADDITIONAL_PARAM"/>
    <elementParameter field="CHECK" name="ACTIVE_DIR_AUTH" value="false" show="false"/>
    <elementParameter field="ENCODING_TYPE" name="ENCODING" value="&quot;ISO-8859-15&quot;" show="false"/>
    <elementParameter field="TECHNICAL" name="ENCODING:ENCODING_TYPE" value="ISO-8859-15"/>
    <elementParameter field="CHECK" name="ENABLE_ALWAYS_ENCRYPTED" value="false" show="false"/>
    <elementParameter field="TEXT" name="KEYSTORE_PRINCIPAL_ID" value="" show="false"/>
    <elementParameter field="PASSWORD" name="KEYSTORE_SECRET" value="" show="false"/>
    <elementParameter field="CHECK" name="TRIM_ALL_COLUMN" value="false"/>
    <elementParameter field="TABLE" name="TRIM_COLUMN">
      <elementValue elementRef="SCHEMA_COLUMN" value="USER_ID"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="USER_WINDOWS_NAME"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="USER_NAME"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="GROUP_ID"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="GROUP_NAME"/>
      <elementValue elementRef="TRIM" value="false"/>
      <elementValue elementRef="SCHEMA_COLUMN" value="SUPERGROUP_ID"/>
